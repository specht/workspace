#!/usr/bin/with-contenv bash
set -euo pipefail

CODE_SERVER=/app/code-server/bin/code-server
EXT_DIR=/workspace/.extensions
RUN_USER_FILE=/run/hackschule-workspace-user

if [ ! -s "$RUN_USER_FILE" ]; then
    echo "ERROR: workspace user was not initialized" >&2
    exit 1
fi

WORKSPACE_RUN_USER="$(cat "$RUN_USER_FILE")"

if ! id "$WORKSPACE_RUN_USER" >/dev/null 2>&1; then
    echo "ERROR: workspace user does not exist: $WORKSPACE_RUN_USER" >&2
    exit 1
fi

WORKSPACE_RUN_GROUP="$(id -gn "$WORKSPACE_RUN_USER")"

# Format:
#   "/path/to/extension.vsix|publisher.extension-id"
#
# Add additional extensions here later.
EXTENSIONS=(
    "/app/extensions/hackschule-sidebar-init-0.1.0.vsix|hackschule.hackschule-sidebar-init"
    "/app/extensions/hackschule-checkpoints-0.6.1.vsix|hackschule.hackschule-checkpoints"
    "/app/extensions/hackschule-keyboard-tutorial-0.5.3.vsix|gymnasiumsteglitz.hackschule-keyboard-tutorial"
    "/app/extensions/bif-authoring-tools-0.2.1.vsix|gymnasiumsteglitz.bif-authoring-tools"
    "/app/extensions/ritwickdey.LiveServer.vsix|ritwickdey.LiveServer"
)

mkdir -p "$EXT_DIR"

get_vsix_version() {
    local vsix="$1"
    local package_json
    local version

    # A VSIX is a ZIP archive. Its extension manifest is stored here.
    package_json="$(unzip -p "$vsix" extension/package.json 2>/dev/null || true)"

    if [ -z "$package_json" ]; then
        echo "ERROR: Could not read extension/package.json from $vsix" >&2
        return 1
    fi

    # package.json generated by vsce normally has "version" on its own line.
    version="$(
        printf '%s\n' "$package_json" |
            sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
            head -n 1
    )"

    if [ -z "$version" ]; then
        echo "ERROR: Could not determine extension version from $vsix" >&2
        return 1
    fi

    printf '%s\n' "$version"
}

list_installed_extensions() {
    "$CODE_SERVER" \
        --extensions-dir "$EXT_DIR" \
        --list-extensions \
        --show-versions \
        2>/dev/null
}

get_installed_version() {
    local snapshot="$1"
    local extension_id="$2"

    printf '%s\n' "$snapshot" |
        awk -F '@' -v wanted="$extension_id" '
            tolower($1) == tolower(wanted) {
                print $2
                exit
            }
        '
}

# Starting code-server's CLI is relatively expensive. A brand-new workspace used
# to launch it once to check each extension, once to install it and once again to
# verify it. Collect the state once, batch all required VSIX installs into a
# single invocation, then verify the result once.
if [ -n "$(find "$EXT_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    INSTALLED_EXTENSIONS="$(list_installed_extensions)"
else
    INSTALLED_EXTENSIONS=""
fi

INSTALL_ARGS=()
EXPECTED_EXTENSIONS=()

for entry in "${EXTENSIONS[@]}"; do
    vsix="${entry%%|*}"
    extension_id="${entry#*|}"

    if [ ! -f "$vsix" ]; then
        echo "WARNING: VSIX not found: $vsix"
        continue
    fi

    wanted_version="$(get_vsix_version "$vsix")"
    installed_version="$(get_installed_version "$INSTALLED_EXTENSIONS" "$extension_id")"
    EXPECTED_EXTENSIONS+=("$extension_id|$wanted_version")

    if [ -z "$installed_version" ]; then
        echo "Installing $extension_id version $wanted_version"
        INSTALL_ARGS+=(--install-extension "$vsix")
    elif dpkg --compare-versions "$installed_version" ge "$wanted_version"; then
        if [ "$installed_version" = "$wanted_version" ]; then
            echo "$extension_id is already up to date: $installed_version"
        else
            echo "$extension_id is newer than bundled version: $installed_version > $wanted_version"
        fi
    else
        echo "Updating $extension_id: $installed_version -> $wanted_version"
        INSTALL_ARGS+=(--install-extension "$vsix")
    fi
done

if (( ${#INSTALL_ARGS[@]} > 0 )); then
    "$CODE_SERVER" \
        --extensions-dir "$EXT_DIR" \
        "${INSTALL_ARGS[@]}" \
        --force \
        >/dev/null

    # One verification pass after the whole batch.
    VERIFIED_EXTENSIONS="$(list_installed_extensions)"
else
    VERIFIED_EXTENSIONS="$INSTALLED_EXTENSIONS"
fi

# Verify all bundled extensions. Newer locally installed versions are accepted,
# matching the previous behavior.
for expected in "${EXPECTED_EXTENSIONS[@]}"; do
    extension_id="${expected%%|*}"
    wanted_version="${expected#*|}"
    verified_version="$(get_installed_version "$VERIFIED_EXTENSIONS" "$extension_id")"

    if [ -z "$verified_version" ] || ! dpkg --compare-versions "$verified_version" ge "$wanted_version"; then
        echo "ERROR: Failed to install $extension_id version $wanted_version." >&2
        echo "Installed version is: ${verified_version:-not found}" >&2
        exit 1
    fi
done

chown -R "$WORKSPACE_RUN_USER:$WORKSPACE_RUN_GROUP" "$EXT_DIR"

if [ -n "${PROXY_DOMAIN:-}" ]; then
    PROXY_DOMAIN_ARG="--proxy-domain=${PROXY_DOMAIN}"
else
    PROXY_DOMAIN_ARG=""
fi

HOME=/workspace USER="$WORKSPACE_RUN_USER" LOGNAME="$WORKSPACE_RUN_USER" exec \
    s6-notifyoncheck \
        -d \
        -n 300 \
        -w 1000 \
        -c "nc -z 127.0.0.1 8443" \
    s6-setuidgid "$WORKSPACE_RUN_USER" \
        "$CODE_SERVER" \
            --bind-addr 0.0.0.0:8443 \
            --disable-telemetry \
            --auth none \
            --extensions-dir "$EXT_DIR" \
            --disable-workspace-trust \
            --disable-update-check \
            --app-name "Hackschule Workspace" \
            --welcome-text "Herzlich Willkommen in der Hackschule" \
            $PROXY_DOMAIN_ARG