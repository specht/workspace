#!/usr/bin/with-contenv bash
set -euo pipefail

CODE_SERVER=/app/code-server/bin/code-server
EXT_DIR=/workspace/.extensions

EXTENSIONS=(
    "/app/extensions/hackschule-sidebar-init.vsix|hackschule.hackschule-sidebar-init"
    "/app/extensions/hackschule-checkpoints-0.5.0.vsix|hackschule.hackschule-checkpoints"
)

mkdir -p "$EXT_DIR"

install_extension_if_needed() {
    local entry="$1"
    local vsix="${entry%%|*}"
    local extension_id="${entry#*|}"

    if [ ! -f "$vsix" ]; then
        echo "WARNING: VSIX not found: $vsix"
        return
    fi

    if "$CODE_SERVER" \
        --extensions-dir "$EXT_DIR" \
        --list-extensions 2>/dev/null |
        grep -Fxq "$extension_id"; then
        echo "VS Code extension already installed: $extension_id"
        return
    fi

    echo "Installing VS Code extension $extension_id from $vsix"

    "$CODE_SERVER" \
        --extensions-dir "$EXT_DIR" \
        --install-extension "$vsix" \
        >/dev/null
}

for extension in "${EXTENSIONS[@]}"; do
    install_extension_if_needed "$extension"
done

chown -R abc:abc "$EXT_DIR"

if [ -n "${PASSWORD:-}" ] || [ -n "${HASHED_PASSWORD:-}" ]; then
    AUTH="password"
else
    AUTH="none"
    echo "Starting with no password"
fi

if [ -n "${PROXY_DOMAIN:-}" ]; then
    PROXY_DOMAIN_ARG="--proxy-domain=${PROXY_DOMAIN}"
else
    PROXY_DOMAIN_ARG=""
fi

HOME=/workspace exec \
    s6-notifyoncheck \
        -d \
        -n 300 \
        -w 1000 \
        -c "nc -z 127.0.0.1 8443" \
    s6-setuidgid abc \
        "$CODE_SERVER" \
            --bind-addr 0.0.0.0:8443 \
            --disable-telemetry \
            --auth none \
            --extensions-dir "$EXT_DIR" \
            --disable-workspace-trust \
            --disable-update-check \
            --app-name "Hackschule VS Code" \
            --welcome-text "Herzlich Willkommen in der Hackschule" \
            $PROXY_DOMAIN_ARG