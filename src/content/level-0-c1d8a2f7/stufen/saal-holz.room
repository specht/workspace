# Ein Saal hinter der Kammer, von Wandlampen beleuchtet.

[room]
name = Saal
height = 3
walls = wood
floor = wood
wallpaper = #b07a48
carpet = #6e4426

[map]
#############
#..N..N..N..#
#...........#
1...........#
#...........#
#...........#
#...........#
#..S..S..S..#
#############

[N]
model = statues/industrial_wall_sconce/industrial_wall_sconce_1k.gltf   # Poly Haven, CC0
height = 0.4
rotation = 0
offset = 0, 1.75, -0.35  # an die Nordwand
light = #ffcf8a
power = 0.7
beam = 75               # unter dem Schirm: nach unten

[S]
model = statues/industrial_wall_sconce/industrial_wall_sconce_1k.gltf   # Poly Haven, CC0
height = 0.4
rotation = 180
offset = 0, 1.75, 0.35   # an die Südwand
light = #ffcf8a
power = 0.7
beam = 75               # unter dem Schirm: nach unten
