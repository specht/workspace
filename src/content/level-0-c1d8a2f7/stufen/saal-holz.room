# Ein Saal hinter der Kammer, von Wandlampen beleuchtet.

[room]
name = Saal
height = 3
walls = wood
floor = wood
wallpaper = #b07a48
carpet = #6e4426

[map]
#############
#..N..N..N..#
#...........#
1...........#
#...........#
#...........#
#...........#
#..S..S..S..#
#############

[N]
model = statues/industrial_wall_lamp/industrial_wall_lamp_1k.gltf   # Poly Haven, CC0
height = 0.43
rotation = 0
offset = 0, 1.9, -0.42   # an die Nordwand
light = #ffd9a0
power = 1.6

[S]
model = statues/industrial_wall_lamp/industrial_wall_lamp_1k.gltf   # Poly Haven, CC0
height = 0.43
rotation = 180
offset = 0, 1.9, 0.42    # an die Südwand
light = #ffd9a0
power = 1.6
