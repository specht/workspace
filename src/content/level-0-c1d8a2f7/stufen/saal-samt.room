# Ein Saal hinter der Kammer, von Wandlampen beleuchtet.

[room]
name = Saal
height = 3
walls = velvet
wallpaper = #7a1424
carpet = #4a2c2a
ceiling = #5a4c50

[map]
#############
#..N..N..N..#
#...........#
1...........#
#...........#
#...........#
#...........#
#..S..S..S..#
#############

[N]
model = models/brass_candleholders/brass_candleholder_03.gltf   # Poly Haven, CC0, nur der große Leuchter
height = 0.83
rotation = 0
offset = 0, 0, -0.2      # vor der Nordwand
pedestal = 0.45, 1, 0.45
pedestal_material = wood
pedestal_color = #3a2418
light = #ffb066
power = 0.9

[S]
model = models/brass_candleholders/brass_candleholder_03.gltf   # Poly Haven, CC0, nur der große Leuchter
height = 0.83
rotation = 180
offset = 0, 0, 0.2       # vor der Südwand
pedestal = 0.45, 1, 0.45
pedestal_material = wood
pedestal_color = #3a2418
light = #ffb066
power = 0.9
