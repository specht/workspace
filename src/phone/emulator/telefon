#!/usr/bin/env python3
"""telefon: the Telefonspiel in the Workspace (docs/plan-telefonspiel.md).

    telefon spiel.rb          (or spiel.py, spiel.js, or a whole command)
    telefon                   (the command from game.json in this folder)
    telefon spiel.rb --nummer FACT --nummer DICE=wuerfel/dice.rb
                              (the numbers call reaches: this game, another one)

Runs the game exactly as the runner does on the real phone (the same code,
src/phone/core/game.py) and serves a page with a telephone: the browser
plays the speech and the music, mixed as on the phone, and sends the keys.
The speech comes from the speech service of the Workspace (phone-speech);
the game's own music files are served from its folder. Only the standard
library, so it runs in every Workspace without installing anything.
"""

import argparse
import asyncio
import contextvars
import json
import mimetypes
import os
import re
import signal
import sys
import urllib.error
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), 'core'))
import game  # noqa: E402

SPEECH = os.environ.get('PHONE_SPEECH', 'http://phone-speech:8000')
PAGE = os.path.join(HERE, 'page.html')
PORT = 8040
# YouTube links in the game's files, fetched before the first call
YOUTUBE = re.compile(r'https://(?:www\.|m\.|music\.)?(?:youtube\.com/(?:watch\?v=|shorts/)|youtu\.be/)[\w-]{6,}(?:[?&][\w=&%.-]*)?')
WATCHED = 50                       # files of the folder looked at, at most
# the fixed texts of say ('…' or "…" right after say or say(), without #{…}
# or an f in front), rendered before the first call
SAY = re.compile(r'''\bsay\s*\(?\s*(['"])((?:\\.|(?!\1)[^\\\n])*)\1''')
# texts the game fills in while it runs: Python's f'…' and JavaScript's `…`;
# of these and of Ruby's "…#{…}…" the sentences without a gap are prepared,
# since the phone fetches every sentence of a text on its own
SAY_FILLED = re.compile(r'''\bsay\s*\(\s*(?:f(['"])((?:\\.|(?!\1)[^\\\n])*)\1|`((?:\\.|[^\\`])*)`)''')
GAP = re.compile(r'#\{|\$\{|\{')
# other texts that look like sentences (a list of questions, say text later):
# a capital letter at the start, . ! ? or … at the end, nothing filled in
SENTENCE = re.compile(r'''(?<![\w])(['"])([A-ZÄÖÜ](?:(?!\1)[^\\\n])*?[.!?…])\1''')
# the same in texts filled in while the game runs, anywhere (a list of
# sentences to choose from): Python's f'…' and JavaScript's `…`; their
# sentences without a gap
FILLED = re.compile(r'''(?<![\w])f(['"])((?:\\.|(?!\1)[^\\\n])*)\1|`((?:\\.|[^\\`])*)`''')
MAX_SENTENCES = 300                # rendered in advance per run, at most
MOOD = re.compile(r'''\bmood\s*[:=]\s*(?:['"]|:)(\w+)''')   # on the rest of the line of a say ('whisper' or :whisper)
COLOR = sys.stdout.isatty()


def paint(code, text):
    return f'\033[{code}m{text}\033[0m' if COLOR else text


def show(text, code=None):
    print(paint(code, text) if code else text, flush=True)


# The origin another page may read this server's answers from, for the
# request being answered (the Telefonbuch's line sets it for a Workspace's
# own page, line.py); None: none, as the emulator itself never needs it.
ORIGIN = contextvars.ContextVar('origin', default=None)


def cross_origin():
    origin = ORIGIN.get()
    return [f'Access-Control-Allow-Origin: {origin}', 'Vary: Origin'] if origin else []


class Emulator(game.Phone):
    """the page in the browser is the other end of the call"""

    def __init__(self, server):
        super().__init__()
        self.server = server
        self.heard = {}
        self.parts = {}
        self.moods = {}                # id of a say → its mood, for the terminal
        self.next_id = 0

    def titled(self, title, subtitle):
        if title:
            self.server.send({'title': title})

    async def say(self, text, interrupt=False, mood=None):
        parts = game.sentences(text)
        if not parts:
            return
        # interrupt: the page stops the voice at a key and says it has heard
        event = {'say': parts, **({'interrupt': True} if interrupt else {}), **({'mood': mood} if mood else {})}
        self.moods[self.next_id + 1] = mood
        await self.until_heard(event, parts)

    async def until_heard(self, event, parts=None):
        """sends the event to the page and waits until the page has played it"""
        self.next_id += 1
        id_ = self.next_id
        done = asyncio.get_running_loop().create_future()
        self.heard[id_] = done
        if parts:
            self.parts[id_] = parts
        self.server.send({**event, 'id': id_})
        ended = asyncio.ensure_future(self.ended.wait())
        try:
            await asyncio.wait({done, ended}, return_when=asyncio.FIRST_COMPLETED)
        finally:
            ended.cancel()
            self.heard.pop(id_, None)
            self.parts.pop(id_, None)

    async def play(self, source, interrupt=False):
        if game.game_file(self.server.folder, source) is None:
            show(f'Aufnahme: Die Datei {source} gibt es im Ordner des Spiels nicht.', '33')
            return
        show(f'Aufnahme: {source}', '1;36')
        # served like a music file of the game; played on the voice's channel
        event = {'play': '/music?' + urllib.parse.urlencode({'source': source}), 'name': source,
                 **({'interrupt': True} if interrupt else {})}
        await self.until_heard(event)

    def playing(self, id_, part):
        """the page starts a sentence: now it appears in the terminal, as a subtitle"""
        parts = self.parts.get(id_, [])
        if 0 <= part < len(parts):
            mood = self.moods.get(id_)
            show(f'Telefon{f" ({game.MOODS[mood]})" if mood else ""}: {parts[part]}', '1;36')

    async def music(self, source, volume=1.0, start=0.0, stop=None):
        try:
            volume = max(0.0, min(1.0, float(volume)))
        except (TypeError, ValueError):
            volume = 1.0
        if not source:
            show('Musik aus', '2')
            self.server.send({'music': None})
            return
        source = str(source)
        if not re.match(r'https?://', source) and game.game_file(self.server.folder, source) is None:
            show(f'Musik: Die Datei {source} gibt es im Ordner des Spiels nicht.', '33')
            return
        show(f'Musik: {source}{game.span_text(start, stop)} (Lautstärke {volume:g})', '2')
        # a YouTube link: the speech service cuts the piece; a file of the
        # game: the page plays it from start and loops back there at stop
        query = {'source': source}
        youtube = bool(re.match(r'https?://', source))
        if youtube:
            query.update({'start': f'{start:g}'} if start else {})
            query.update({'stop': f'{stop:g}'} if stop is not None else {})
        event = {'music': '/music?' + urllib.parse.urlencode(query), 'volume': volume}
        if not youtube and (start or stop is not None):
            event['loop'] = [start, stop]
        # as on the phone, the game goes on when the music plays (or failed)
        await self.until_heard(event)

    async def dtmf(self, digits):
        """the page plays the key tones; the game goes on when they are heard"""
        show(f'Töne auf der Leitung: {" ".join(digits)}', '2')
        await self.until_heard({'tones': digits})

    async def call_game(self, dialed):
        return await self.server.call_from(self, dialed)

    async def line_signal(self, kind, seconds=0.0):
        """the page plays the line's sounds (ringing and picking up, busy)"""
        show({'ring': f'Es klingelt ({seconds:g} s), dann wird abgenommen.', 'busy': 'Besetzt.'}.get(kind, kind), '2')
        await self.until_heard({'signal': kind, 'seconds': seconds})

    async def read_keys(self, count, timeout_ms):
        self.server.send({'keys': count, 'timeout': timeout_ms})
        digits = await super().read_keys(count, timeout_ms)
        self.server.send({'keysDone': digits})
        show(f'… das Spiel bekommt {json.dumps(digits)}', '2')
        return digits


class Server:
    def __init__(self, command, folder, numbers=None):
        self.command = command
        self.folder = folder
        # the numbers a game here may call (telefon spiel.rb --nummer FACT,
        # --nummer DICE=wuerfel/dice.rb): digits → (command, folder)
        self.numbers = numbers or {}
        self.events = None             # the page's event stream (one page at a time)
        self.phone = None
        self.call = None
        self.fetched = set()           # YouTube links asked for (without t=)
        self.spoken = set()            # (sentence, mood) asked for
        self.mood_missing = False      # said once: the speech service has no moods

    # music in advance ------------------------------------------------------------

    async def watch_music(self):
        """every two seconds: the YouTube links in the game's files (.rb,
        .py, .js in its folder), and each new one fetched at once, so a call
        does not wait for the download"""
        seen = {}
        while True:
            try:
                names = sorted(n for n in os.listdir(self.folder) if os.path.splitext(n)[1] in game.LANGUAGES)[:WATCHED]
            except OSError:
                names = []
            for name in names:
                path = os.path.join(self.folder, name)
                try:
                    stamp = os.stat(path).st_mtime
                    if seen.get(path) == stamp:
                        continue
                    seen[path] = stamp
                    with open(path, encoding='utf-8', errors='replace') as f:
                        text = f.read(1_000_000)
                except OSError:
                    continue
                for link in YOUTUBE.findall(text):
                    source = game.youtube_link(game.youtube_start(link)[0])
                    if source not in self.fetched:
                        self.fetched.add(source)
                        asyncio.ensure_future(self.fetch_music(source))
                new = []
                said = []                        # where the says' texts stand
                found = [(m, m.group(2), '#{') for m in SAY.finditer(text)] + \
                    [(m, m.group(2) if m.group(2) is not None else m.group(3), '{') for m in SAY_FILLED.finditer(text)]
                for m, literal, gap in found:
                    said.append((m.start(0), m.end(0)))
                    literal = re.sub(r'''\\(['"\\`])''', r'\1', literal)
                    line_end = text.find('\n', m.end())
                    rest = MOOD.search(text, m.end(), len(text) if line_end < 0 else line_end)
                    mood = rest.group(1) if rest and rest.group(1) in game.MOODS else None
                    for sentence in game.sentences(literal):
                        if gap in sentence:      # filled in while the game runs: made then
                            continue
                        if (sentence, mood) not in self.spoken and len(self.spoken) < MAX_SENTENCES:
                            self.spoken.add((sentence, mood))
                            new.append((sentence, mood))
                others = [(m.start(2), m.group(2)) for m in SENTENCE.finditer(text)] + \
                    [(m.start(), m.group(2) if m.group(2) is not None else m.group(3)) for m in FILLED.finditer(text)]
                for at, literal in others:
                    if any(a <= at < b for a, b in said):
                        continue
                    for sentence in game.sentences(literal):
                        # filled in while the game runs: made then
                        if GAP.search(sentence) or not re.match(r'[A-ZÄÖÜ]', sentence):
                            continue
                        if (sentence, None) not in self.spoken and len(self.spoken) < MAX_SENTENCES:
                            self.spoken.add((sentence, None))
                            new.append((sentence, None))
                if new:
                    asyncio.ensure_future(self.render(new))
            await asyncio.sleep(2)

    async def render(self, sentences):
        """the sentences made by the speech service now, two at a time, so a
        call takes them from its cache"""
        show(f'{len(sentences)} {"Satz wird" if len(sentences) == 1 else "Sätze werden"} vorbereitet …', '2')
        def fetch(item):
            sentence, mood = item
            # prepare: after the sentences a call waits for (speech/server.py)
            query = urllib.parse.urlencode({'text': sentence, 'format': 'f32', 'prepare': '1', **({'mood': mood} if mood else {})})
            with urllib.request.urlopen(f'{SPEECH}/speech?{query}', timeout=60) as r:
                r.read()
        loop = asyncio.get_running_loop()
        failed = 0
        for i in range(0, len(sentences), 2):
            results = await asyncio.gather(*(loop.run_in_executor(None, fetch, s) for s in sentences[i:i + 2]),
                                           return_exceptions=True)
            for sentence, result in zip(sentences[i:i + 2], results):
                if isinstance(result, Exception):
                    failed += 1
                    self.spoken.discard(sentence)     # again when the file changes
        if failed:
            show(f'{failed} von {len(sentences)} Sätzen ließen sich nicht vorbereiten; sie kommen beim Anruf.', '33')
        else:
            show(f'{"Satz" if len(sentences) == 1 else "Sätze"} bereit.', '2')

    async def fetch_music(self, source):
        show(f'Musik wird geholt: {source}', '2')
        def fetch():
            query = urllib.parse.urlencode({'source': source, 'format': 'mp3'})
            with urllib.request.urlopen(f'{SPEECH}/music?{query}', timeout=330) as r:
                r.read()
        try:
            await asyncio.get_running_loop().run_in_executor(None, fetch)
            show(f'Musik bereit: {source}', '2')
        except urllib.error.HTTPError as error:
            show(f'Musik: {source} ließ sich nicht holen: {error.read().decode("utf-8", "replace")[:200]}', '33')
        except (OSError, ValueError):
            self.fetched.discard(source)      # the speech service was away: again when the file changes
            show(f'Musik: {source} ließ sich nicht holen, der Sprachdienst ist nicht erreichbar.', '33')

    # the event stream to the page --------------------------------------------

    def send(self, event):
        if self.events is None:
            return
        try:
            self.events.write(b'data: ' + json.dumps(event, ensure_ascii=False).encode('utf-8') + b'\n\n')
        except (ConnectionError, RuntimeError):
            pass

    async def stream(self, reader, writer):
        """until the page goes away: then the caller has hung up"""
        if self.events is not None:
            self.send({'replaced': True})
            self.events.close()
            self.hang_up()
        self.events = writer
        # no-transform: code-server's proxy gzips everything else and would
        # hold the stream back until enough bytes collect
        writer.write(b'HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache, no-transform\r\n'
                     b'X-Accel-Buffering: no\r\n' + ''.join(h + '\r\n' for h in cross_origin()).encode('latin-1') + b'\r\n')
        self.send({'ready': True, 'title': self.title()})

        async def ping():
            while True:
                await asyncio.sleep(15)
                writer.write(b': ping\n\n')
                await writer.drain()
        pinging = asyncio.ensure_future(ping())
        try:
            await asyncio.wait({pinging, asyncio.ensure_future(reader.read())},
                               return_when=asyncio.FIRST_COMPLETED)
        finally:
            pinging.cancel()
            if self.events is writer:
                self.events = None
                self.hang_up()

    def title(self):
        try:
            with open(os.path.join(self.folder, 'game.json')) as f:
                return str(json.load(f)['title'])
        except (OSError, ValueError, KeyError, TypeError):
            # the file that answers (hoehle.rb), so a student sees which one runs
            files = [c for c in self.command if os.path.splitext(c)[1] in game.LANGUAGES]
            return os.path.basename(files[-1]) if files else os.path.basename(self.folder)

    # the call ------------------------------------------------------------------

    def hang_up(self):
        if self.phone is not None:
            self.phone.ended.set()

    async def run_call(self):
        self.phone = phone = Emulator(self)
        # it rings until the game answers, as on the line
        phone.unanswered = game.ring_seconds()
        show('')
        show(f'Anruf: {" ".join(self.command)}', '1')
        env = game.environment()
        try:
            reason, status = await game.run_game(
                phone, self.command, self.folder, env,
                lambda kind, line: print(paint('31', line) if kind == 'err' else line, flush=True))
        except OSError as error:
            show(f'Das Spiel ließ sich nicht starten: {error}', '31')
            reason, status = 'ended', None
        if reason == 'caller':
            show('Aufgelegt.', '1')
        elif reason == 'hangup':
            show('Das Spiel hat aufgelegt.', '1')
        elif reason == 'back':
            show(f'Das Spiel hat mit back geantwortet: {json.dumps(phone.returned)}. '
                 'Von einem Menschen gewählt, ist der Anruf damit zu Ende.', '1')
        elif reason == 'transfer':
            # the published games are on the server, not here
            show(f'Weitergeleitet an {phone.transfer_to}: Auf dem echten Telefon geht der Anruf im Spiel mit dieser Nummer weiter.', '1')
        elif status:
            show(f'Das Spiel ist mit einem Fehler beendet (Exit-Code {status}); die Meldung steht oben.', '1;31')
        else:
            show('Das Spiel ist zu Ende.', '1')
        if self.phone is phone:
            self.phone = None
            ended = {'ended': reason}
            if reason == 'transfer':
                ended['number'] = phone.transfer_to       # the page offers it in the Telefonbuch
            self.send(ended)

    async def call_from(self, holding, dialed):
        """call in the Workspace: the games given with --nummer, the one
        running here among them; the holding game waits, then is on the line
        again with only the answer. Any other number: »Kein Anschluss«"""
        number, extension = game.match_number(dialed, self.numbers)
        if number is None:
            show(f'Rückfrage bei {dialed}: Kein Anschluss. Im Workspace erreicht call nur Spiele, die du beim Start nennst, '
                 'zum Beispiel: telefon spiel.rb --nummer FACT (dieses Spiel) oder --nummer DICE=wuerfel/dice.rb.', '33')
            await holding.say('Kein Anschluss unter dieser Nummer.')
            return ''
        command, folder = self.numbers[number]
        show(f'Rückfrage bei {number}{f" mit {extension}" if extension else ""}: {" ".join(command)} (das Spiel davor wartet)', '1')
        callee = Emulator(self)
        callee.depth = holding.depth + 1
        callee.fresh_keys(extension)
        callee.unanswered = game.ring_seconds()
        held_folder, self.folder, self.phone = self.folder, folder, callee
        try:
            reason, status = await game.run_game(
                callee, command, folder, game.environment(),
                lambda kind, line: print(paint('31', line) if kind == 'err' else line, flush=True))
        except OSError as error:
            show(f'Das Spiel ließ sich nicht starten: {error}', '31')
            reason, status = 'ended', None
        finally:
            self.folder = held_folder
            if self.phone is callee:
                self.phone = holding
        if callee.ended.is_set():
            holding.ended.set()
        if reason == 'ended' and status:
            show(f'Das gerufene Spiel ist mit einem Fehler beendet (Exit-Code {status}); das Spiel davor bekommt keine Antwort.', '1;31')
            await holding.say(game.CRASHED_CALLED)
        answer = callee.returned if reason == 'back' and callee.returned is not None else ''
        # ended without a sound: nobody answered, the line is busy
        if callee.unanswered is not None and not callee.ended.is_set():
            callee.unanswered = None
            await holding.line_signal('busy')
        show(f'Zurück im Spiel davor, die Antwort: {json.dumps(answer)}', '1')
        holding.fresh_keys()
        return answer

    async def start_call(self):
        if self.call and not self.call.done():
            self.hang_up()
            await asyncio.wait({self.call}, timeout=3)
        self.call = asyncio.ensure_future(self.run_call())

    # HTTP ----------------------------------------------------------------------

    async def handle(self, reader, writer):
        try:
            request = await asyncio.wait_for(reader.readline(), 30)
            parts = request.decode('latin-1').split()
            if len(parts) < 2:
                return
            method, target = parts[0], parts[1]
            length = 0
            while True:
                line = await asyncio.wait_for(reader.readline(), 30)
                if line in (b'\r\n', b'\n', b''):
                    break
                name, _, value = line.decode('latin-1').partition(':')
                if name.strip().lower() == 'content-length':
                    length = min(int(value.strip() or 0), 65536)
            body = await reader.readexactly(length) if length else b''
            url = urllib.parse.urlsplit(target)
            query = dict(urllib.parse.parse_qsl(url.query))
            await self.route(method, url.path, query, body, reader, writer)
        except (ConnectionError, asyncio.TimeoutError, asyncio.IncompleteReadError, ValueError):
            pass
        finally:
            try:
                writer.close()
            except RuntimeError:
                pass

    def respond(self, writer, status, body=b'', content_type='text/plain; charset=utf-8', headers=()):
        reason = {200: 'OK', 204: 'No Content', 400: 'Bad Request', 404: 'Not Found', 502: 'Bad Gateway'}[status]
        head = [f'HTTP/1.1 {status} {reason}', f'Content-Type: {content_type}',
                f'Content-Length: {len(body)}', 'Connection: close', *headers, *cross_origin()]
        writer.write(('\r\n'.join(head) + '\r\n\r\n').encode('latin-1') + body)

    async def route(self, method, path, query, body, reader, writer):
        if method == 'GET' and path == '/':
            with open(PAGE, 'rb') as f:
                self.respond(writer, 200, f.read(), 'text/html; charset=utf-8', ['Cache-Control: no-cache'])
        elif method == 'GET' and path == '/events':
            await self.stream(reader, writer)
        elif method == 'POST' and path == '/call':
            await self.start_call()
            self.respond(writer, 204)
        elif method == 'POST' and path == '/hangup':
            self.hang_up()
            self.respond(writer, 204)
        elif method == 'POST' and path == '/key':
            key = query.get('key', '')
            if self.phone is not None and len(key) == 1 and key in '0123456789*#':
                show(f'Taste {key}', '1;33')
                self.phone.press(key)
            self.respond(writer, 204)
        elif method == 'POST' and path == '/heard':
            done = self.phone.heard.get(int(query.get('id', '0'))) if self.phone else None
            if done is not None and not done.done():
                done.set_result(True)
            self.respond(writer, 204)
        elif method == 'POST' and path == '/playing':
            if self.phone is not None:
                self.phone.playing(int(query.get('id', '0')), int(query.get('part', '-1')))
            self.respond(writer, 204)
        elif method == 'POST' and path == '/problem':
            show(body.decode('utf-8', 'replace')[:500], '33')
            self.respond(writer, 204)
        elif method == 'GET' and path == '/speech':
            mood = query.get('mood', '')
            await self.proxy(writer, '/speech', {'text': query.get('text', '')[:500], 'format': 'wav',
                                                 **({'mood': mood} if mood in game.MOODS else {})}, 60)
        elif method == 'GET' and path == '/music':
            source = query.get('source', '')
            if re.match(r'https?://', source):
                params = {k: query[k] for k in ('start', 'stop') if query.get(k)}
                await self.proxy(writer, '/music', {'source': source, 'format': 'mp3', **params}, 330)
            else:
                file = game.game_file(self.folder, source)
                if file is None:
                    self.respond(writer, 404, b'not in the game\'s folder')
                else:
                    with open(file, 'rb') as f:
                        data = f.read()
                    # no-cache: a file replaced under the same name plays new at the next call
                    self.respond(writer, 200, data, mimetypes.guess_type(file)[0] or 'application/octet-stream',
                                 ['Cache-Control: no-cache'])
        else:
            self.respond(writer, 404, b'not found')

    async def proxy(self, writer, path, params, timeout):
        """the speech service answers; its errors go to the page as 502"""
        def fetch():
            with urllib.request.urlopen(SPEECH + path + '?' + urllib.parse.urlencode(params), timeout=timeout) as r:
                return r.read(), r.headers.get('Content-Type', 'application/octet-stream'), r.headers.get('X-Phone-Mood')
        try:
            data, content_type, mood = await asyncio.get_running_loop().run_in_executor(None, fetch)
            if mood == 'missing' and not self.mood_missing:
                self.mood_missing = True
                show('Der Sprachdienst kennt noch keine Stimmungen (sein Image ist älter als telefon); '
                     'Thorsten spricht ohne Stimmung. Sag deiner Lehrkraft Bescheid.', '33')
            self.respond(writer, 200, data, content_type, ['Cache-Control: no-cache'] if mood else [])
        except urllib.error.HTTPError as error:
            self.respond(writer, 502, error.read()[:500] or str(error).encode())
        except (urllib.error.URLError, OSError) as error:
            self.respond(writer, 502, f'Der Sprachdienst ist nicht erreichbar ({SPEECH}): {error}'.encode())


class TestPhone(game.Phone):
    """telefon --test: the game without a page, as the phone check runs it
    (src/ruby/include/phone_check.rb). Each keys() of the game takes the
    next answer of --keys (»-« for none, as after a timeout); the keys of an
    answer are pressed one by one, so keys left over wait for the next
    question as on the phone. Pauses take no time. One line per event:
    »Telefon: …«, »Musik: …«, »Pause: …«, »Tasten: …«, »Ausgabe: …« (what
    the game prints), »Fehler: …« (its errors) and »Ende: …«."""

    def __init__(self, answers):
        super().__init__()
        self.answers = list(answers)
        self.folder = None

    def titled(self, title, subtitle):
        if title:
            print(f'Titel: {" ".join(title.split())}', flush=True)
        if subtitle:
            print(f'Untertitel: {" ".join(subtitle.split())}', flush=True)

    async def say(self, text, interrupt=False, mood=None):
        print(f'Telefon{f" ({mood})" if mood else ""}: {" ".join(str(text).split())}', flush=True)

    async def music(self, source, volume=1.0, start=0.0, stop=None):
        if not source:
            print('Musik: aus', flush=True)
        elif not re.match(r'https?://', str(source)) and game.game_file(self.folder, str(source)) is None:
            print(f'Musik: {source} (diese Datei gibt es im Ordner des Spiels nicht)', flush=True)
        else:
            print(f'Musik: {source}{game.span_text(start, stop)}', flush=True)

    async def play(self, source, interrupt=False):
        if game.game_file(self.folder, source) is None:
            print(f'Aufnahme: {source} (diese Datei gibt es im Ordner des Spiels nicht)', flush=True)
        else:
            print(f'Aufnahme: {source}', flush=True)

    async def sleep(self, ms):
        try:
            print(f'Pause: {float(ms) / 1000:g} s', flush=True)
        except (TypeError, ValueError):
            print('Pause', flush=True)

    async def dtmf(self, digits):
        print(f'Töne: {digits}', flush=True)

    async def line_signal(self, kind, seconds=0.0):
        print({'ring': 'Leitung: Es klingelt, dann wird abgenommen.', 'busy': 'Leitung: besetzt.'}.get(kind, kind), flush=True)

    async def call_game(self, dialed):
        print(f'Rückfrage: {dialed} (in der Prüfung geht niemand ran, die Antwort ist leer)', flush=True)
        return ''

    async def read_keys(self, count, timeout_ms):
        if not self.answers and self.keys.empty():
            print(f'Ende: Das Spiel wartet auf {"eine Taste" if count == 1 else f"bis zu {count} Tasten"}, '
                  'aber die Prüfung drückt keine mehr.', flush=True)
            self.ended.set()
            return ''
        if self.answers:
            answer = self.answers.pop(0)
            for key in ('' if answer == '-' else answer):
                self.press(key)
        digits = ''
        while len(digits) < count and not self.keys.empty():
            key = self.keys.get_nowait()       # as Phone.read_keys: # ends early, the rest waits
            if key == '#':
                break
            digits += key
        print(f'Tasten: {digits if digits else "(keine)"}', flush=True)
        return digits


async def test(command, folder, answers, seconds):
    phone = TestPhone(answers)
    phone.folder = folder

    def output(kind, line):
        print(f'{"Fehler" if kind == "err" else "Ausgabe"}: {line}', flush=True)
    try:
        reason, status = await game.run_game(phone, command, folder, game.environment(), output, seconds=seconds)
    except OSError as error:
        print(f'Ende: Das Spiel ließ sich nicht starten: {error}', flush=True)
        return
    if reason == 'hangup':
        print('Ende: Das Spiel hat aufgelegt.', flush=True)
    elif reason == 'back':
        print(f'Ende: Antwort {phone.returned or "(leer)"}.', flush=True)
    elif reason == 'transfer':
        print(f'Ende: Weitergeleitet an {phone.transfer_to}.', flush=True)
    elif reason == 'time':
        print(f'Ende: Das Spiel lief länger als {seconds} Sekunden.', flush=True)
    elif reason == 'ended' and status:
        print(f'Ende: Das Spiel ist mit einem Fehler beendet (Exit-Code {status}).', flush=True)
    elif reason == 'ended':
        print('Ende: Das Spiel ist zu Ende.', flush=True)


def find_game(args):
    """the command and the folder it runs in"""
    if not args:
        if not os.path.exists('game.json'):
            sys.exit('Aufruf: telefon spiel.rb   (oder spiel.py, spiel.js; ohne Angabe: der Befehl aus game.json)')
        with open('game.json') as f:
            return game.command_for(json.load(f)['command']), os.getcwd()
    if len(args) == 1 and os.path.isfile(args[0]):
        folder, name = os.path.split(os.path.abspath(args[0]))
        if os.path.splitext(name)[1] not in game.LANGUAGES:
            sys.exit(f'telefon kennt Dateien mit {", ".join(game.LANGUAGES)}; '
                     f'für andere schreib den ganzen Befehl, zum Beispiel: telefon ./{name}')
        return game.command_for([name]), folder
    if len(args) == 1 and os.path.splitext(args[0])[1] in game.LANGUAGES:
        sys.exit(f'Die Datei {args[0]} gibt es hier nicht.')
    return list(args), os.getcwd()


async def serve(command, folder, port, numbers=None):
    server = Server(command, folder, numbers)
    for candidate in range(port, port + 20):
        try:
            listener = await asyncio.start_server(server.handle, '0.0.0.0', candidate)
            break
        except OSError:
            continue
    else:
        sys.exit(f'Kein freier Port zwischen {port} und {port + 19}.')
    proxy = os.environ.get('VSCODE_PROXY_URI', '')
    address = proxy.replace('{{port}}', str(candidate)) if '{{port}}' in proxy else f'http://localhost:{candidate}/'
    show(f'Das Telefon läuft auf Port {candidate}.', '1')
    show(f'Öffne {address} im Browser (die Adresse steht auch im Reiter »Ports«) und klick auf den grünen Hörer.')
    show('Beenden mit Strg+C.', '2')
    watching = asyncio.ensure_future(server.watch_music())
    loop = asyncio.get_running_loop()
    stop = loop.create_future()

    def interrupt():
        if stop.done():
            os._exit(130)          # a second Strg+C: at once
        stop.set_result(True)
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, interrupt)
    await stop
    watching.cancel()
    server.hang_up()
    if server.call and not server.call.done():
        await asyncio.wait({server.call}, timeout=3)
    # the page keeps its event stream open, and a server waits for every
    # connection before it closes (Python 3.12 and later): close them here
    listener.close()
    if server.events is not None:
        server.events.close()
    if hasattr(listener, 'close_clients'):
        listener.close_clients()
    try:
        await asyncio.wait_for(listener.wait_closed(), 2)
    except asyncio.TimeoutError:
        pass
    show('')


def main():
    parser = argparse.ArgumentParser(prog='telefon', description='Das Telefonspiel im Workspace ausprobieren.')
    parser.add_argument('--port', type=int, default=PORT, help=f'der Port der Seite (Standard: {PORT})')
    parser.add_argument('--test', action='store_true',
                        help='ohne Seite: die Tasten aus --keys, eine Zeile je Ereignis (für die Prüfungen)')
    parser.add_argument('--keys', default='', help='mit --test: die Antworten auf keys(), mit Kommas, »-« für keine')
    parser.add_argument('--seconds', type=int, default=10, help='mit --test: so lange darf das Spiel laufen')
    parser.add_argument('command', nargs=argparse.REMAINDER, help='spiel.rb, spiel.py, spiel.js oder ein Befehl')
    options = parser.parse_args()
    # --nummer anywhere (after the game's file, too): the numbers call reaches here
    rest, given = [], []
    args = list(options.command)
    while args:
        word = args.pop(0)
        if word == '--nummer' and args:
            given.append(args.pop(0))
        elif word.startswith('--nummer='):
            given.append(word.split('=', 1)[1])
        else:
            rest.append(word)
    command, folder = find_game(rest)
    numbers = {}
    for item in given:
        number, _, file = item.partition('=')
        digits = game.dial_digits(number)
        if not digits or not re.fullmatch(r'\d{3,4}', digits):
            sys.exit(f'--nummer {item}: Eine Spielnummer hat drei oder vier Ziffern oder Buchstaben.')
        if file:
            if not os.path.isfile(file):
                sys.exit(f'--nummer {item}: Die Datei {file} gibt es nicht.')
            other_folder, name = os.path.split(os.path.abspath(file))
            numbers[digits] = (game.command_for([name]), other_folder)
        else:
            numbers[digits] = (command, folder)
    if options.test:
        answers = [a.strip() for a in options.keys.split(',')] if options.keys.strip() else []
        asyncio.run(test(command, folder, answers, options.seconds))
    else:
        asyncio.run(serve(command, folder, options.port, numbers))


if __name__ == '__main__':
    main()
