{
    "//": "Earlier defaults from default-vscode-settings.json. A person whose setting still has one of these values gets the current default; a setting they changed stays.",
    "latex-workshop.latex.tools": [
        [
            {
                "name": "lualatex",
                "command": "lualatex",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "%DOC%"
                ]
            },
            {
                "name": "latexmk-lualatex",
                "command": "latexmk",
                "args": [
                    "-lualatex",
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "%DOC%"
                ]
            }
        ]
    ],
    "latex-workshop.latex.recipes": [
        [
            {
                "name": "LuaLaTeX",
                "tools": [
                    "lualatex"
                ]
            },
            {
                "name": "latexmk (LuaLaTeX)",
                "tools": [
                    "latexmk-lualatex"
                ]
            }
        ]
    ]
}
