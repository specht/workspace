{
    "chat.disableAIFeatures": true,

    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,

    "editor.fontFamily": "'0xProto Nerd Font Mono', monospace",
    "editor.minimap.enabled": false,
    "files.autoSave": "off",
    "files.dialog.defaultPath": "/workspace",
    "files.exclude": {
        ".hs-kbd-tutorial": true,
        "**/.hs-kbd-tutorial/**": true,
        ".extensions": true,
        ".exam-extensions": true,
        ".ssh": true,
        ".cache": true,
        ".local": true,
        ".config": true,
        ".npm": true,
        ".pub-cache": true,

        ".gitconfig": true,
        ".hackschule": true,
        ".my.cnf": true,
        ".myclirc": true,
        ".bash_history": true,
        ".bash_logout": true,
        ".bashrc": true,
        ".profile": true,

        "**/.build": true,
        "**/*.synctex.gz": true
    },

    "html.autoClosingTags": false,
    "js/ts.autoClosingTags.enabled": false,

    "terminal.integrated.fontFamily": "'0xProto Nerd Font Mono', monospace",
    "terminal.integrated.lineHeight": 1.0,
    "terminal.integrated.customGlyphs": true,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.stickyScroll.enabled": false,

    "keyboard.layout": "de",

    "window.menuBarVisibility": "visible",
    "workbench.startupEditor": "none",
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.colorTheme": "Dark 2026",

    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.auxDir": "%DIR%/.build",
    "latex-workshop.latex.recipe.default": "latexmk (LuaLaTeX)",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.latex.build.enableMagicComments": false,

    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-lualatex",
            "command": "latexmk",
            "args": [
                "-lualatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ]
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (LuaLaTeX)",
            "tools": [
                "latexmk-lualatex"
            ]
        }
    ],

    "latex-workshop.latex.clean.enabled": true,
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.bcf",
        "*.blg",
        "*.idx",
        "*.ilg",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.run.xml"
    ]
}