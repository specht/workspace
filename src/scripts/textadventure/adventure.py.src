# Ein Textadventure aus Objekten: Nachts in der Schule.


class Room:
    def __init__(self, name, description):
        self.name = name
        self.description = description
        self._exits = {}
@5         self._locks = {}
@2         self.items = []

    def connect(self, direction, room):
        self._exits[direction] = room

    def exit_to(self, direction):
        return self._exits.get(direction)

    def directions(self):
        return list(self._exits.keys())
@2 
@2     def add_item(self, item):
@2         self.items.append(item)
@2 
@2     def take(self, name):
@2         for item in self.items:
@2             if item.name == name:
@2                 self.items.remove(item)
@2                 return item
@2         return None
@5 
@5     def lock(self, direction, key_name):
@5         self._locks[direction] = key_name
@5 
@5     def is_locked(self, direction):
@5         return direction in self._locks
@5 
@5     def unlock(self, key_name):
@5         doors = [d for d, key in self._locks.items() if key == key_name]
@5         for direction in doors:
@5             del self._locks[direction]
@5         return len(doors) > 0
@6 
@6     def is_dark(self):
@6         return False
@7 
@7     def is_goal(self):
@7         return False
@3 
@3     def describe(self):
@3         lines = [self.name, self.description]
@3         if self.items:
@3             lines.append("Hier liegt: " + ", ".join(item.name for item in self.items))
@3-4         exits = self.directions()
@5         exits = [d + " (verschlossen)" if self.is_locked(d) else d for d in self.directions()]
@3         lines.append("Ausgänge: " + (", ".join(exits) if exits else "keine"))
@3         return "\n".join(lines)
