//// Chest.java @8
import java.util.ArrayList;
import java.util.List;

// Eine Kiste mit Inhalt: Öffnet man sie, liegt der Inhalt im Raum.
public class Chest extends Item {
    private final List<Item> contents = new ArrayList<>();

    public Chest(String name, String description) {
        super(name, description);
    }

    public void put(Item item) {
        contents.add(item);
    }

    @Override
    public String use(Player player) {
        if (contents.isEmpty()) {
            return getName() + " ist leer.";
        }
        List<String> names = new ArrayList<>();
        for (Item item : contents) {
            names.add(item.getName());
            player.getRoom().addItem(item);
        }
        contents.clear();
        return "Du öffnest " + getName() + ". Darin: " + String.join(", ", names);
    }
}
//// Player.java @4
import java.util.ArrayList;
import java.util.List;

// Die Spielerin: Sie steht in einem Raum und hat eine Tasche.
public class Player {
    private Room room;
    private final List<Item> bag = new ArrayList<>();

    public Player(Room room) {
        this.room = room;
    }

    public Room getRoom() {
        return room;
    }

    public String look() {
@6         if (room.isDark() && !hasLight()) {
@6             return "Es ist stockdunkel. Du siehst nichts.";
@6         }
        return room.describe();
    }

    public String go(String direction) {
        Room target = room.exitTo(direction);
        if (target == null) {
            return "Da geht es nicht weiter.";
        }
@5         if (room.isLocked(direction)) {
@5             return "Die Tür nach " + direction + " ist verschlossen.";
@5         }
        room = target;
        return look();
    }

    public String take(String name) {
@6         if (room.isDark() && !hasLight()) {
@6             return "Im Dunkeln findest du nichts.";
@6         }
        Item item = room.take(name);
        if (item == null) {
            return "Hier liegt nichts mit dem Namen " + name + ".";
        }
        bag.add(item);
        return "Du nimmst " + item.getName() + ".";
    }

    public boolean has(String name) {
        for (Item item : bag) {
            if (item.getName().equals(name)) {
                return true;
            }
        }
        return false;
    }

    public String bag() {
        if (bag.isEmpty()) {
            return "Deine Tasche ist leer.";
        }
        List<String> names = new ArrayList<>();
        for (Item item : bag) {
            names.add(item.getName());
        }
        return "In deiner Tasche: " + String.join(", ", names);
    }
@5
@5     public void remove(Item item) {
@5         bag.remove(item);
@5     }
@5
@5     public String use(String name) {
@5         for (Item item : bag) {
@5             if (item.getName().equals(name)) {
@5                 return item.use(this);
@5             }
@5         }
@5         return "Du hast nichts mit dem Namen " + name + ".";
@5     }
@6
@6     public boolean hasLight() {
@6         for (Item item : bag) {
@6             if (item.shines()) {
@6                 return true;
@6             }
@6         }
@6         return false;
@6     }
@7
@7     public String examine(String name) {
@7         List<Item> visible = new ArrayList<>(bag);
@7         visible.addAll(room.getItems());
@7         for (Item item : visible) {
@7             if (item.getName().equals(name)) {
@7                 return item.getDescription();
@7             }
@7         }
@7         return "Hier gibt es nichts mit dem Namen " + name + ".";
@7     }
}
//// Game.java @7
// Das Spiel: versteht eine getippte Zeile und gibt die Antwort zurück.
public class Game {
    private final Player player;
    private boolean over = false;

    public Game(Player player) {
        this.player = player;
    }

    public String start() {
        return player.look();
    }

    public boolean isOver() {
        return over;
    }

    public boolean isWon() {
        return player.getRoom().isGoal();
    }

    public String handle(String line) {
        String[] parts = line.strip().toLowerCase().split(" ", 2);
        String verb = parts[0];
        String word = parts.length > 1 ? parts[1] : "";
        String answer;
        if (verb.equals("gehe")) {
            answer = player.go(word);
        } else if (verb.equals("nimm")) {
            answer = player.take(word);
        } else if (verb.equals("benutze")) {
            answer = player.use(word);
        } else if (verb.equals("untersuche")) {
            answer = player.examine(word);
        } else if (verb.equals("schau")) {
            answer = player.look();
        } else if (verb.equals("tasche")) {
            answer = player.bag();
        } else if (verb.equals("ende")) {
            over = true;
            answer = "Bis bald.";
        } else {
            answer = "Das verstehe ich nicht. Befehle: gehe, nimm, benutze, untersuche, schau, tasche, ende";
        }
        if (isWon()) {
            over = true;
        }
        return answer;
    }
}
//// World.java @8
import java.util.ArrayList;
import java.util.List;

// Deine Welt: ein Wohnheim, in dem das Licht ausgefallen ist.
public class World {
    // Der Weg zum Ziel, Befehl für Befehl: Game spielt ihn durch.
    public static final List<String> WALKTHROUGH = List.of(
        "nimm kerze", "gehe flur", "gehe küche", "nimm kastenschlüssel", "gehe flur",
        "benutze kastenschlüssel", "gehe kasten");

    public static Player build() {
        Room room = new Room("Zimmer 3", "Dein Zimmer im Wohnheim. Der Strom ist weg.");
        Room corridor = new DarkRoom("Gang", "Ein langer Gang mit Türen links und rechts.");
        Room kitchen = new Room("Küche", "Im Kühlschrank brummt nichts mehr.");
        Room fuse = new GoalRoom("Sicherungskasten", "Du legst den Schalter um, und überall geht das Licht an. Geschafft!");
        room.connect("flur", corridor);
        corridor.connect("zimmer", room);
        corridor.connect("küche", kitchen);
        kitchen.connect("flur", corridor);
        corridor.connect("kasten", fuse);
        corridor.lock("kasten", "kastenschlüssel");
        room.addItem(new Lamp("kerze", "Eine Kerze, die schon brennt."));
        kitchen.addItem(new Key("kastenschlüssel", "Ein kleiner Schlüssel mit einem Blitz darauf."));
        kitchen.addItem(new Food("keks", "Ein bisschen weich, aber gut."));
        return new Player(room);
    }

    // Alle Räume, die man von start aus erreicht, start zuerst (gegeben).
    public static List<Room> allRooms(Room start) {
        List<Room> seen = new ArrayList<>(List.of(start));
        List<Room> queue = new ArrayList<>(List.of(start));
        while (!queue.isEmpty()) {
            Room room = queue.remove(0);
            for (String direction : room.getDirections()) {
                Room other = room.exitTo(direction);
                if (!seen.contains(other)) {
                    seen.add(other);
                    queue.add(other);
                }
            }
        }
        return seen;
    }
}
