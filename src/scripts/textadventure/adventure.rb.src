# Ein Textadventure aus Objekten: Nachts in der Schule.

class Room
@1-1   attr_reader :name, :description
@2   attr_reader :name, :description, :items

  def initialize(name, description)
    @name = name
    @description = description
    @exits = {}
@5     @locks = {}
@2     @items = []
  end

  def connect(direction, room)
    @exits[direction] = room
  end

  def exit_to(direction)
    @exits[direction]
  end

  def directions
    @exits.keys
  end
@2 
@2   def add_item(item)
@2     @items << item
@2   end
@2 
@2   def take(name)
@2     item = @items.find { |i| i.name == name }
@2     @items.delete(item) if item
@2     item
@2   end
@5 
@5   def lock(direction, key_name)
@5     @locks[direction] = key_name
@5   end
@5 
@5   def locked?(direction)
@5     @locks.key?(direction)
@5   end
@5 
@5   def unlock(key_name)
@5     doors = @locks.select { |_, key| key == key_name }.keys
@5     doors.each { |direction| @locks.delete(direction) }
@5     !doors.empty?
@5   end
@6 
@6   def dark?
@6     false
@6   end
@7 
@7   def goal?
@7     false
@7   end
@3 
@3   def describe
@3     lines = [@name, @description]
@3     lines << "Hier liegt: #{@items.map(&:name).join(', ')}" unless @items.empty?
@3-4     exits = directions
@5     exits = directions.map { |d| locked?(d) ? "#{d} (verschlossen)" : d }
@3     lines << "Ausgänge: #{exits.empty? ? 'keine' : exits.join(', ')}"
@3     lines.join("\n")
@3   end
end
@6 
@6 class DarkRoom < Room
@6   def dark?
@6     true
@6   end
@6 end
@7 
@7 class GoalRoom < Room
@7   def goal?
@7     true
@7   end
@7 end
